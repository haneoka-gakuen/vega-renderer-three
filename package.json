{
  "name": "@haneoka/vega-renderer-three",
  "version": "0.1.0",
  "description": "Official Three.js WebGL2 renderer for the Vega visual novel engine",
  "keywords": [
    "visual-novel",
    "three.js",
    "renderer",
    "webgl2",
    "vega"
  ],
  "license": "MPL-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haneoka-gakuen/vega-renderer-three.git"
  },
  "homepage": "https://github.com/haneoka-gakuen/vega-renderer-three#readme",
  "bugs": {
    "url": "https://github.com/haneoka-gakuen/vega-renderer-three/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "LICENSE-SCOPE.md",
    "NOTICE.md",
    "README.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:package": "node scripts/verify-package.mjs",
    "check": "pnpm run typecheck && pnpm run build && pnpm run verify:package",
    "prepack": "pnpm run check"
  },
  "peerDependencies": {
    "@haneoka/vega": "^0.1.0",
    "howler": ">=2.2.0 <3",
    "three": ">=0.184.0 <0.185.0"
  },
  "devDependencies": {
    "@haneoka/vega": "^0.1.0",
    "@types/howler": "^2.2.13",
    "@types/three": "^0.184.1",
    "howler": "2.2.4",
    "three": "0.184.0",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "packageManager": "pnpm@11.14.0",
  "vega": {
    "pluginApi": 1,
    "kind": "renderer",
    "capabilities": [
      "render"
    ],
    "permissions": [
      "render:webgl"
    ],
    "targets": [
      "web",
      "pwa",
      "electron",
      "tauri",
      "android",
      "ios"
    ]
  }
}
